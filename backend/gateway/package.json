      "undici": "^8.10.0",
      "zod": "^3.24.4"
    },
    "devDependencies": {
      "@types/amqplib": "^0.10.7",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^22.15.3",
      "prettier": "^3.5.3",
      "tsx": "^4.19.4",
      "typescript": "^5.8.3"
    }
  }
  