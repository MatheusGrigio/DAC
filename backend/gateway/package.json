{
    "name": "bantads-gateway",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
      "dev": "tsx watch src/index.ts",
      "build": "tsc -p tsconfig.json",
      "start": "node dist/index.js",
      "test": "tsx --test test/**/*.test.ts",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
