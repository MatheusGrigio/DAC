# --- Postgres ---
POSTGRES_DB=bantads
POSTGRES_USER=bantads
POSTGRES_PASSWORD=change-me
POSTGRES_CLIENTE_USER=bantads_cliente
POSTGRES_CLIENTE_PASSWORD=change-me
POSTGRES_GERENTE_USER=bantads_gerente
POSTGRES_GERENTE_PASSWORD=change-me
POSTGRES_CONTA_COMMAND_USER=bantads_conta_command
POSTGRES_CONTA_COMMAND_PASSWORD=change-me
POSTGRES_CONTA_QUERY_USER=bantads_conta_query
POSTGRES_CONTA_QUERY_PASSWORD=change-me

# --- MongoDB (usado pelo Auth) ---
MONGO_USER=bantads
MONGO_PASSWORD=change-me
MONGO_DB=bantads_auth

# --- RabbitMQ ---
RABBIT_USER=bantads
RABBIT_PASSWORD=change-me

# --- Gateway ---
GATEWAY_PUBLIC_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:4200

# --- Email (dev) ---
MAIL_DEV=true
GMAIL_USER=
GMAIL_APP_PASSWORD=